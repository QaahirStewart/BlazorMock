                    <div class="text-xs text-gray-500 mb-1">6. Load Pokemon list with type information</div>
                    <p class="text-xs text-gray-600 mb-2">
                        On page load, fetch all 151 Pokemon from the API. Then, load type data for the first 50 Pokemon
                        so you can
                        filter by type. This balances functionality with performance!
                    </p>
                    <ul class="list-disc ml-4 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li>Main call: <code>GetFromJsonAsync&lt;PokemonListResponse&gt;("pokemon?limit=151")</code>
                        </li>
                        <li>Extract ID from URL: <code>int.Parse(result.Url.TrimEnd('/').Split('/').Last())</code></li>
                        <li>Build sprite URL: <code>PokeAPI/sprites/.../official-artwork/{id}.png</code></li>
                        <li>Load types for first 50: <code>allPokemon.Take(50)</code> to keep it fast</li>
                        <li><code>Task.WhenAll(typeTasks)</code> loads all type data in parallel</li>
                    </ul>
                    <pre class="code-block text-xs font-mono text-gray-800">protected override async Task OnInitializedAsync()
{
    await LoadPokemonList();
}

private async Task LoadPokemonList()
{
    isLoading = true;
    try {
        var response = await Http.GetFromJsonAsync&lt;PokemonListResponse&gt;("https://pokeapi.co/api/v2/pokemon?limit=151");
        if (response?.Results != null) {
            foreach (var result in response.Results) {
                var id = int.Parse(result.Url.TrimEnd('/').Split('/').Last());
                allPokemon.Add(new PokemonListItem {
                    Id = id,
                    Name = result.Name,
                    SpriteUrl = $"https://raw.githubusercontent.com/PokeAPI/sprites/.../official-artwork/{id}.png"
                });
            }
            
            // Load types for first 50 Pokemon (for filtering)
            var typeTasks = allPokemon.Take(50).Select(async p =&gt; {
                var details = await Http.GetFromJsonAsync&lt;PokemonDetailResponse&gt;(p.Url);
                if (details?.Types != null) {
                    p.Types = details.Types.Select(t =&gt; t.Type.Name).ToList();
                }
            });
            await Task.WhenAll(typeTasks);
            
            ApplyFilters();
        }
    } finally {
        isLoading = false;
    }
}</pre>
