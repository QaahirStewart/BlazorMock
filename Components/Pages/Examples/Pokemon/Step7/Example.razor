                    <pre class="code-block text-xs font-mono text-gray-800">@@code {
    private List&lt;PokemonListItem&gt; allPokemon = new();
    private List&lt;PokemonListItem&gt; filteredPokemon = new();
    private PokemonDetail? selectedPokemon;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string searchTerm = string.Empty;
    private string selectedType = string.Empty;
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalPages =&gt; (int)Math.Ceiling(filteredPokemon.Count / (double)pageSize);
    
    // Models match PokeAPI JSON structure
    private class PokemonListItem { /* Id, Name, Url, SpriteUrl, Types */ }
    private class PokemonDetail { /* Id, Name, Types, Stats, Abilities, etc. */ }
}</pre>
