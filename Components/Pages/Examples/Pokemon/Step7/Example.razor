                    <p class="text-xs text-gray-600 mb-2">
                        Slice the filtered list to show only the current page's Pokemon. Previous/Next methods update
                        the page number
                        with bounds checking to prevent going out of range.
                    </p>
                    <ul class="list-disc ml-4 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li><code>Skip((currentPage - 1) * pageSize)</code> skips to the right position in the list</li>
                        <li><code>Take(pageSize)</code> grabs exactly 20 Pokemon for this page</li>
                        <li><code>if (currentPage &gt; 1)</code> prevents going below page 1</li>
                        <li><code>if (currentPage &lt; totalPages)</code> prevents going past the last page</li>
                    </ul>
                    <pre class="code-block text-xs font-mono text-gray-800">private List&lt;PokemonListItem&gt; GetPagedPokemon()
{
    return filteredPokemon
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();
}

private void PreviousPage()
{
    if (currentPage &gt; 1) {
        currentPage--;
    }
}

private void NextPage()
{
    if (currentPage &lt; totalPages) {
        currentPage++;
    }
}</pre>
