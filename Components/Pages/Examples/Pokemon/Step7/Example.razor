                        Tailwind CSS classes. This makes your UI look professional and visually consistent!
                    </p>
                    <ul class="list-disc ml-4 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li><code>type.ToLower()</code> normalizes input so "Fire" and "fire" both work</li>
                        <li>Switch expressions: <code>=&gt;</code> syntax is cleaner than if/else chains</li>
                        <li>Badge classes use <code>bg-red-50 text-red-700</code> for subtle colored backgrounds</li>
                        <li>Chip classes use <code>bg-red-500 text-white</code> for bold, vibrant colors</li>
                        <li>Background classes use gradients: <code>from-red-300 to-orange-200</code></li>
                    </ul>
                    <pre class="code-block text-xs font-mono text-gray-800">private string GetTypeBadgeClass(string type) =&gt; type.ToLower() switch
{
    "fire" =&gt; "px-2.5 py-1 bg-red-50 text-red-700 border border-red-200 rounded-md text-xs font-medium capitalize",
    "water" =&gt; "px-2.5 py-1 bg-blue-50 text-blue-700 border border-blue-200 rounded-md text-xs font-medium capitalize",
    "grass" =&gt; "px-2.5 py-1 bg-green-50 text-green-700 border border-green-200 rounded-md text-xs font-medium capitalize",
    _ =&gt; "px-2.5 py-1 bg-gray-100 text-gray-700 border border-gray-200 rounded-md text-xs font-medium capitalize"
};

private string GetTypeBackgroundColor(string type) =&gt; type.ToLower() switch
{
    "fire" =&gt; "bg-gradient-to-br from-red-300 to-orange-200",
    "water" =&gt; "bg-gradient-to-br from-blue-300 to-blue-200",
    // Add all 18 types with beautiful gradients!
};

private string GetTypeChipClass(string type) =&gt; type.ToLower() switch
{
    "fire" =&gt; "px-4 py-1.5 bg-red-500 text-white rounded-full text-sm font-semibold capitalize",
    "water" =&gt; "px-4 py-1.5 bg-blue-500 text-white rounded-full text-sm font-semibold capitalize",
    // Vibrant colors for modal type chips
};</pre>
                </div>

                <!-- Step 10 -->
                <div class="bg-gray-100 border border-gray-200 rounded-lg p-4">
                    <div class="text-xs text-gray-500 mb-1">@@code block (C#)</div>
                    <div class="text-xs text-gray-500 mb-1">10. Add type effectiveness (weaknesses) logic</div>
                    <p class="text-xs text-gray-600 mb-2">
                        Create a method that returns which types are super effective against each Pokemon type. This
                        helps users plan
                        battles and makes your Pokedex feel complete and informative!
                    </p>
                    <ul class="list-disc ml-4 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li>Based on official Pokemon type chart (Grass is weak to Fire, Ice, Poison, Flying, Bug)</li>
                        <li>Returns a <code>List&lt;string&gt;</code> of type names that are super effective</li>
                        <li>Display in modal:
                            <code>@@foreach (var weakness in GetTypeWeaknesses(pokemon.Types.First()))</code>
                        </li>
                        <li>Style with colored chips using <code>GetWeaknessChipClass(weakness)</code></li>
                    </ul>
                    <pre class="code-block text-xs font-mono text-gray-800">private List&lt;string&gt; GetTypeWeaknesses(string type) =&gt; type.ToLower() switch
{
    "grass" =&gt; new List&lt;string&gt; { "Fire", "Ice", "Poison", "Flying", "Bug" },
    "fire" =&gt; new List&lt;string&gt; { "Water", "Ground", "Rock" },
    "water" =&gt; new List&lt;string&gt; { "Electric", "Grass" },
    "electric" =&gt; new List&lt;string&gt; { "Ground" },
    "normal" =&gt; new List&lt;string&gt; { "Fighting" },
    // Add all 18 types based on Pokemon type chart
    _ =&gt; new List&lt;string&gt; { "Fighting" }
};

// In Razor, display in modal:
&lt;div class="mb-6"&gt;
    &lt;h3 class="text-base font-bold mb-3"&gt;Weakness&lt;/h3&gt;
    &lt;div class="flex flex-wrap gap-2"&gt;
        @@foreach (var weakness in GetTypeWeaknesses(primaryType))
        {
            &lt;span class="@@GetWeaknessChipClass(weakness)"&gt;@@weakness&lt;/span&gt;
        }
    &lt;/div&gt;
&lt;/div&gt;</pre>
                </div>

                <!-- Step 11 -->
                <div class="bg-gray-100 border border-gray-200 rounded-lg p-4">
                    <div class="text-xs text-gray-500 mb-1">@@code block (C#)</div>
                    <div class="text-xs text-gray-500 mb-1">11. Create evolution chain data</div>
                    <p class="text-xs text-gray-600 mb-2">
                        Build a method that returns the full evolution chain for any Pokemon. Use hardcoded data for the
                        first 151
                        Pokemon (in a real app, you'd fetch this from the PokeAPI evolution endpoints).
                    </p>
                    <ul class="list-disc ml-4 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li>Returns <code>List&lt;int&gt;</code> of Pokemon IDs in evolution order</li>
                        <li>Example: Charmander (4) → Charmeleon (5) → Charizard (6)</li>
                        <li>All 3 stages return the same chain: <code>new List&lt;int&gt; { 4, 5, 6 }</code></li>
                        <li>Display with clickable sprites and arrows in between</li>
                        <li>Single-stage Pokemon just return their own ID: <code>{ pokemonId }</code></li>
                    </ul>
                    <pre class="code-block text-xs font-mono text-gray-800">private List&lt;int&gt; GetEvolutionChain(int pokemonId) =&gt; pokemonId switch
{
    1 =&gt; new List&lt;int&gt; { 1, 2, 3 }, // Bulbasaur → Ivysaur → Venusaur
    2 =&gt; new List&lt;int&gt; { 1, 2, 3 },
    3 =&gt; new List&lt;int&gt; { 1, 2, 3 },
    4 =&gt; new List&lt;int&gt; { 4, 5, 6 }, // Charmander → Charmeleon → Charizard
    5 =&gt; new List&lt;int&gt; { 4, 5, 6 },
    6 =&gt; new List&lt;int&gt; { 4, 5, 6 },
    25 =&gt; new List&lt;int&gt; { 25, 26 }, // Pikachu → Raichu
    26 =&gt; new List&lt;int&gt; { 25, 26 },
    // Add all evolution chains for 151 Pokemon
    _ =&gt; new List&lt;int&gt; { pokemonId } // Single stage (no evolution)
};

// In Razor modal:
&lt;div class="flex items-center justify-center gap-4"&gt;
    @@{
        var evolutionIds = GetEvolutionChain(selectedPokemon.Id);
        for (int i = 0; i &lt; evolutionIds.Count; i++)
        {
            var evoId = evolutionIds[i];
            &lt;div @@onclick="() =&gt; ShowDetails(evoId)" class="w-20 h-20 cursor-pointer"&gt;
                &lt;img src="@@GetSpriteUrl(evoId)" class="w-full h-full object-contain" /&gt;
            &lt;/div&gt;
            if (i &lt; evolutionIds.Count - 1) {
                &lt;span class="text-xl text-gray-400"&gt;→&lt;/span&gt;
            }
        }
    }
&lt;/div&gt;</pre>
