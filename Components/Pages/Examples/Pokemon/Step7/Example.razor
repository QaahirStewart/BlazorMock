            <!-- Demo.razor Code Block -->
            <div class="bg-gray-100 border border-gray-200 rounded-lg p-4 overflow-x-auto mb-4">
                <div class="text-xs text-gray-500 mb-1">Components/Pages/Pokemon/Demo.razor</div>
                <p class="text-xs text-gray-600 mb-2">The complete Razor markup with search, filters, grid, pagination,
                    and detail modal</p>
                <ul class="list-disc ml-4 mb-3 text-[11px] text-gray-600 space-y-1">
                    <li>Page directive with route and render mode</li>
                    <li>Search bar and type filter dropdown in the header</li>
                    <li>Loading and error states for better UX</li>
                    <li>Responsive Pokemon grid with hover effects</li>
                    <li>Pagination controls</li>
                    <li>Beautiful detail modal with type-based gradient backgrounds, stats, weaknesses, and evolutions
                    </li>
                </ul>
                <pre data-code-title="Razor (Demo.razor)"
                    class="code-block text-xs sm:text-sm font-mono text-gray-800 w-full max-w-full overflow-x-auto">@@page "/pokemon/demo"
@@rendermode InteractiveServer

&lt;PageTitle&gt;Pokedex Demo&lt;/PageTitle&gt;

&lt;style&gt;
    @@@@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .fade-in { animation: fadeIn 0.3s ease-out; }
&lt;/style&gt;

&lt;div class="py-2"&gt;
    &lt;div class="w-full mx-auto p-6 max-w-7xl"&gt;

       &lt;!-- Header --&gt;
        &lt;div class="text-center mb-12"&gt;
            &lt;div class="flex flex-col items-center justify-center gap-3 mb-4"&gt;
                &lt;img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/25.png"
                    alt="Pikachu" class="w-20 h-20 sm:w-24 sm:h-24" /&gt;
                &lt;h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900"&gt;Pokedex Demo&lt;/h1&gt;
            &lt;/div&gt;
            &lt;p class="text-base sm:text-lg md:text-xl text-gray-600 mb-4 leading-relaxed"&gt;
                Browse, search, filter by type, and explore Pokemon with rich details
            &lt;/p&gt;
        &lt;/div&gt;

        &lt;!-- Search Bar & Type Filter --&gt;
        &lt;div class="rounded-xl border border-gray-200 bg-white p-3 mb-4"&gt;
            &lt;div class="flex flex-col sm:flex-row gap-2"&gt;
                &lt;div class="flex-1"&gt;
                    &lt;input type="text" @@bind="searchQuery" @@bind:event="oninput" @@bind:after="ApplyFilters"
                        placeholder="Search Pokemon..." class="w-full rounded-lg border border-gray-300 p-2" /&gt;
                &lt;/div&gt;
                &lt;div class="sm:w-48"&gt;
                    &lt;select @@bind="selectedType" @@bind:after="ApplyFilters"
                        class="w-full rounded-lg border border-gray-300 p-2"&gt;
                        &lt;option value=""&gt;All Types&lt;/option&gt;
                        &lt;option value="normal"&gt;Normal&lt;/option&gt;
                        &lt;option value="fire"&gt;Fire&lt;/option&gt;
                        &lt;option value="water"&gt;Water&lt;/option&gt;
                        &lt;option value="electric"&gt;Electric&lt;/option&gt;
                        &lt;option value="grass"&gt;Grass&lt;/option&gt;
                        &lt;option value="ice"&gt;Ice&lt;/option&gt;
                        &lt;option value="fighting"&gt;Fighting&lt;/option&gt;
                        &lt;option value="poison"&gt;Poison&lt;/option&gt;
                        &lt;option value="ground"&gt;Ground&lt;/option&gt;
                        &lt;option value="flying"&gt;Flying&lt;/option&gt;
                        &lt;option value="psychic"&gt;Psychic&lt;/option&gt;
                        &lt;option value="bug"&gt;Bug&lt;/option&gt;
                        &lt;option value="rock"&gt;Rock&lt;/option&gt;
                        &lt;option value="ghost"&gt;Ghost&lt;/option&gt;
                        &lt;option value="dragon"&gt;Dragon&lt;/option&gt;
                        &lt;option value="dark"&gt;Dark&lt;/option&gt;
                        &lt;option value="steel"&gt;Steel&lt;/option&gt;
                        &lt;option value="fairy"&gt;Fairy&lt;/option&gt;
                    &lt;/select&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;

        &lt;!-- Loading State --&gt;
        @@if (isLoading)
        {
            &lt;div class="text-center py-8"&gt;
                &lt;div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-gray-200 border-t-blue-600"&gt;&lt;/div&gt;
                &lt;p class="mt-3 text-sm text-gray-600"&gt;Loading Pokemon...&lt;/p&gt;
            &lt;/div&gt;
        }

        &lt;!-- Error State --&gt;
        @@if (!string.IsNullOrEmpty(errorMessage))
        {
            &lt;div class="max-w-2xl mx-auto bg-white border-2 border-red-200 rounded-xl p-4"&gt;
                &lt;div class="flex items-start gap-3"&gt;
                    &lt;span class="text-2xl"&gt;⚠️&lt;/span&gt;
                    &lt;div&gt;
                        &lt;h3 class="font-semibold text-gray-900 mb-1"&gt;Error Loading Pokemon&lt;/h3&gt;
                        &lt;p class="text-gray-600 text-sm mb-3"&gt;@@errorMessage&lt;/p&gt;
                        &lt;button @@onclick="LoadPokemonAsync"
                            class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700"&gt;
                            Try Again
                        &lt;/button&gt;
                    &lt;/div&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        }

        &lt;!-- Pokemon Grid --&gt;
        @@if (!isLoading &amp;&amp; string.IsNullOrEmpty(errorMessage) &amp;&amp; filteredPokemon != null)
        {
            @@if (filteredPokemon.Count == 0)
            {
                &lt;div class="text-center py-8"&gt;
                    &lt;span class="text-3xl mb-2 block opacity-50"&gt;🔍&lt;/span&gt;
                    &lt;h3 class="text-lg font-semibold text-gray-900 mb-1"&gt;No Pokemon Found&lt;/h3&gt;
                    &lt;p class="text-sm text-gray-500"&gt;Try adjusting your search or filter&lt;/p&gt;
                &lt;/div&gt;
            }
            else
            {
                &lt;div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 mb-4 fade-in"&gt;
                    @@foreach (var pokemon in CurrentPagePokemon)
                    {
                        &lt;div class="border-2 border-gray-200 rounded-xl overflow-hidden hover:border-blue-400 
                                    hover:shadow-xl transition-all duration-200 cursor-pointer group"
                            @@onclick="() =&gt; ShowDetails(pokemon.Id)"&gt;
                            &lt;div class="aspect-square bg-linear-to-br from-gray-50 to-gray-100"&gt;
                                &lt;img src="@@pokemon.SpriteUrl" alt="@@pokemon.Name"
                                    class="w-full h-full object-contain p-2 group-hover:scale-110 transition-transform duration-300"
                                    loading="lazy" /&gt;
                            &lt;/div&gt;
