                    <p class="text-xs text-gray-600 mb-2">
                        Filter the Pokemon list by BOTH name and type simultaneously. Use LINQ's <code>Where</code> with
                        conditions
                        for each filter, and reset to page 1 whenever filters change.
                    </p>
                    <ul class="list-disc ml-4 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li><code>IsNullOrWhiteSpace(searchTerm)</code> means no search filter applied (show all)</li>
                        <li><code>Contains(..., OrdinalIgnoreCase)</code> for case-insensitive name matching</li>
                        <li><code>p.Types?.Contains(selectedType) ?? false</code> checks if Pokemon has that type</li>
                        <li><code>matchesSearch && matchesType</code> means BOTH conditions must be true</li>
                        <li><code>currentPage = 1</code> resets to first page after filtering</li>
                    </ul>
                    <pre class="code-block text-xs font-mono text-gray-800">private void ApplyFilters()
{
    filteredPokemon = allPokemon.Where(p =&gt;
    {
        var matchesSearch = string.IsNullOrWhiteSpace(searchTerm) ||
            p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
        
        var matchesType = string.IsNullOrWhiteSpace(selectedType) ||
            (p.Types?.Contains(selectedType) ?? false);
        
        return matchesSearch && matchesType;
    }).ToList();

    currentPage = 1;
    StateHasChanged();
}</pre>
