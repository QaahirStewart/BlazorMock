                &lt;/button&gt;
                &lt;img src="@@selectedPokemon.SpriteUrl" class="w-64 h-64 object-contain drop-shadow-2xl" /&gt;
            &lt;/div&gt;
            
            &lt;!-- White Content Card (overlaps gradient) --&gt;
            &lt;div class="bg-white rounded-t-3xl -mt-24 relative z-10 px-6 pt-6 pb-8 overflow-y-auto"&gt;
                &lt;h2 class="text-3xl font-bold capitalize mb-2"&gt;@@selectedPokemon.Name&lt;/h2&gt;
                &lt;!-- Type chips, stats grid, weaknesses, evolution chain --&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
}</pre>
