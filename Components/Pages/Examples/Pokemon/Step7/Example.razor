                <!-- Step 11 -->
                <div class="bg-gray-100 border border-gray-200 rounded-lg p-4">
                    <div class="text-xs text-gray-500 mb-1">Demo.razor.cs</div>
                    <div class="text-xs text-gray-500 mb-1">11. Create evolution chain data</div>
                    <p class="text-xs text-gray-600 mb-2">
                        Build a method that returns the full evolution chain for any Pokemon. Use the <code>or</code>
                        pattern
                        in switch expressions to group all stages of an evolution line together.
                    </p>
                    <ul class="list-disc ml-4 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li>Returns <code>List&lt;int&gt;</code> of Pokemon IDs in evolution order</li>
                        <li>Use <code>1 or 2 or 3 =&gt;</code> to return same chain for any stage</li>
                        <li>Example: Charmander (4), Charmeleon (5), Charizard (6) all return <code>{ 4, 5, 6 }</code>
                        </li>
                        <li>Single-stage Pokemon return just their own ID</li>
                        <li>Display with clickable sprites and arrows in between</li>
                    </ul>
                    <pre class="code-block text-xs font-mono text-gray-800">private List&lt;int&gt; GetEvolutionChain(int pokemonId) =&gt; pokemonId switch
{
    // Starters
    1 or 2 or 3 =&gt; new() { 1, 2, 3 },       // Bulbasaur -&gt; Ivysaur -&gt; Venusaur
    4 or 5 or 6 =&gt; new() { 4, 5, 6 },       // Charmander -&gt; Charmeleon -&gt; Charizard
    7 or 8 or 9 =&gt; new() { 7, 8, 9 },       // Squirtle -&gt; Wartortle -&gt; Blastoise
    
    // Bug types
    10 or 11 or 12 =&gt; new() { 10, 11, 12 }, // Caterpie -&gt; Metapod -&gt; Butterfree
    13 or 14 or 15 =&gt; new() { 13, 14, 15 }, // Weedle -&gt; Kakuna -&gt; Beedrill
    
    // Pikachu line
    25 or 26 =&gt; new() { 25, 26 },           // Pikachu -&gt; Raichu
    
    // Abra line  
    63 or 64 or 65 =&gt; new() { 63, 64, 65 }, // Abra -&gt; Kadabra -&gt; Alakazam
    
    // Ghost line
    92 or 93 or 94 =&gt; new() { 92, 93, 94 }, // Gastly -&gt; Haunter -&gt; Gengar
    
    // Dragon line
    147 or 148 or 149 =&gt; new() { 147, 148, 149 }, // Dratini -&gt; Dragonair -&gt; Dragonite
    
    _ =&gt; new() { pokemonId }                // Single stage (no evolution)
};

// In Razor modal:
&lt;div class="flex items-center justify-center gap-4"&gt;
    @@{
        var evolutionIds = GetEvolutionChain(selectedPokemon.Id);
        for (int i = 0; i &lt; evolutionIds.Count; i++)
        {
            var evoId = evolutionIds[i];
            &lt;div @@onclick="() =&gt; ShowDetails(evoId)" class="w-20 h-20 cursor-pointer"&gt;
                &lt;img src="@@GetSpriteUrl(evoId)" class="w-full h-full object-contain" /&gt;
            &lt;/div&gt;
            @@if (i &lt; evolutionIds.Count - 1)
            {
                &lt;div class="text-gray-400 text-xl"&gt;→&lt;/div&gt;
            }
        }
    }
&lt;/div&gt;</pre>
