@page "/pokemon-examples/step4"
@rendermode InteractiveServer
@inherits ExampleBase

<PageTitle>Pokemon Step 4: Loading & Error States - Example</PageTitle>

<div class="min-h-screen py-8 rounded-4xl bg-gray-50">
    <div class="w-full mx-auto px-4 max-w-5xl">
        <!-- Back link -->
        <a href="/pokemon-guide"
            class="inline-flex items-center gap-2 text-sm sm:text-base text-blue-600 hover:text-blue-700 mb-4">
            <span>←</span> Back to Pokemon Guide
        </a>

        <!-- Title -->
        <h1 class="text-4xl font-bold text-gray-900 mb-4">
            ⏳ Step 4: Loading & Error States
        </h1>

        <!-- Description -->
        <p class="text-xl text-gray-600 mb-8">
            Create a polished loading experience with skeleton screens that show users exactly where data will appear.
        </p>

        <!-- What You'll Learn (Gradient Banner) -->
        <div class="bg-gradient-to-r from-gray-100 to-blue-100 rounded-2xl p-5 sm:p-6 mb-6">
            <h2 class="text-xl sm:text-2xl font-semibold text-gray-800 mb-4">What You'll Learn</h2>

            <p class="text-gray-700 mb-4 text-sm sm:text-base">
                Ever see those slick loading animations on YouTube or Facebook where gray placeholders show up before
                the real content? That's what we're building! You'll create skeleton screens that give users a
                preview of what's loading, then smoothly reveal the actual data when it arrives.
            </p>

            <ul class="list-disc ml-6 text-sm sm:text-base text-gray-700 space-y-2 mb-4">
                <li>Build animated skeleton screens that preview your layout</li>
                <li>Handle data loading in phases (cards first, then images)</li>
                <li>Display friendly error messages with retry buttons</li>
                <li>Show "empty state" messages when there's no data</li>
            </ul>

            <div class="mt-2 pt-3 border-t border-blue-200">
                <p class="text-xs sm:text-sm text-gray-700 mb-2">
                    <strong>💡 Key Concepts:</strong> Skeleton screens, phased loading, pulse animations, error
                    handling, progressive image loading
                </p>
                <div class="flex flex-wrap items-center gap-2">
                    <span class="text-xs sm:text-sm text-gray-600">→ Related tips:</span>
                    <a href="/tips#try-catch-finally"
                        class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-[11px] sm:text-xs font-medium hover:bg-blue-200 transition-colors">try-catch-finally</a>
                    <a href="/tips#loading-state-pattern"
                        class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-[11px] sm:text-xs font-medium hover:bg-blue-200 transition-colors">Loading
                        State Pattern</a>
                    <a href="/tips#error-state-pattern"
                        class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-[11px] sm:text-xs font-medium hover:bg-blue-200 transition-colors">Error
                        State Pattern</a>
                    <a href="/tips#statehaschanged"
                        class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-[11px] sm:text-xs font-medium hover:bg-blue-200 transition-colors">StateHasChanged</a>
                </div>
            </div>
        </div>

        <!-- Sample Component (White Card) -->
        <div class="bg-white rounded-xl p-6 border border-gray-200 mb-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4">🧩 Sample Component: Pokemon with Skeleton Loading</h2>

            <p class="text-sm text-gray-600 mb-4">
                This component creates a professional loading experience: it shows animated skeleton cards while
                fetching Pokemon, displays the names immediately when data arrives, then gradually loads images. It
                also handles errors and empty states gracefully.
            </p>

            <!-- Full code example -->
            <div class="bg-gray-100 border border-gray-200 rounded-lg p-4 overflow-x-auto mb-4">
                <div class="text-xs text-gray-500 mb-1">Components/Pages/Pokemon/Loading.razor</div>
                <p class="text-xs text-gray-600 mb-2">Here's the complete example with skeleton loading screens that
                    animate while waiting for data.</p>
                <ul class="list-disc ml-4 mb-3 text-[11px] text-gray-600 space-y-1">
                    <li>Shows pulsing skeleton cards while loading</li>
                    <li>Displays data in two phases: names first, then images</li>
                    <li>Handles errors with friendly messages and retry buttons</li>
                    <li>Shows "no data" state when the list is empty</li>
                </ul>
                <pre data-code-title="Razor + C# (Loading.razor)"
                    class="code-block text-xs sm:text-sm font-mono text-gray-800 w-full max-w-full overflow-x-auto">@@page "/pokemon/loading"
@@inject IHttpClientFactory HttpClientFactory
@@rendermode InteractiveServer

&lt;h3 class="text-xl font-semibold mb-3"&gt;Pokemon with Loading States&lt;/h3&gt;

@@if (isLoading)
{
    &lt;div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"&gt;
        @@for (int i = 0; i &lt; 3; i++)
        {
            &lt;div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm animate-pulse flex flex-col"&gt;
                &lt;div class="w-full aspect-square bg-slate-100 rounded-xl mb-4"&gt;&lt;/div&gt;
                &lt;div class="h-px w-full bg-slate-100 mb-4"&gt;&lt;/div&gt;
                &lt;div class="h-3 bg-slate-200 rounded w-1/4 mb-2"&gt;&lt;/div&gt;
                &lt;div class="h-4 bg-slate-200 rounded w-1/2"&gt;&lt;/div&gt;
            &lt;/div&gt;
        }
    &lt;/div&gt;
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    &lt;div class="bg-red-50 border-2 border-red-200 rounded-xl p-6"&gt;
        &lt;h3 class="text-red-800 font-semibold mb-2"&gt;⚠️ Error&lt;/h3&gt;
        &lt;p class="text-red-700"&gt;@@errorMessage&lt;/p&gt;
        &lt;button @@onclick="RetryLoad"
            class="mt-4 px-4 py-2 bg-red-600 hover:bg-red-700 
                   text-white rounded-lg transition-colors"&gt;
            Retry
        &lt;/button&gt;
    &lt;/div&gt;
}
else if (allPokemon.Count == 0)
{
    &lt;div class="text-center p-12 text-gray-500"&gt;
        &lt;p class="text-lg font-medium"&gt;No Pokemon found&lt;/p&gt;
        &lt;p class="text-sm mt-2"&gt;Try again later or check your connection.&lt;/p&gt;
    &lt;/div&gt;
}
else
{
    &lt;div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"&gt;
        @@foreach (var pokemon in allPokemon.Take(3))
        {
            &lt;div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col"&gt;
                @@if (showImages)
                {
                    &lt;img src="@@GetPokemonImageUrl(pokemon.Url)" alt="@@pokemon.Name"
                        class="w-full aspect-square object-contain mb-4 transition-opacity duration-300 opacity-100"
                        loading="lazy" /&gt;
                }
                else
                {
                    &lt;div class="w-full aspect-square bg-slate-100 rounded-xl mb-4"&gt;&lt;/div&gt;
                }
                &lt;div class="h-px w-full bg-slate-100 mb-4"&gt;&lt;/div&gt;
                &lt;p class="text-xs text-slate-500 mb-1"&gt;#@@GetPokemonId(pokemon.Url).PadLeft(3, '0')&lt;/p&gt;
                &lt;p class="text-base font-semibold text-sky-900 capitalize"&gt;
                    @@pokemon.Name
                &lt;/p&gt;
            &lt;/div&gt;
        }
    &lt;/div&gt;
}</pre>
            </div>

            <!-- Step-by-step breakdown -->
            <h3 class="text-sm font-semibold text-gray-800 mb-2">Step-by-step breakdown</h3>
            <div class="grid gap-4">
                <div class="bg-gray-100 border border-gray-200 rounded-lg p-4">
                    <div class="text-xs text-gray-500 mb-1">Components/Pages/Pokemon/Loading.razor</div>
                    <div class="text-xs text-gray-500 mb-1">1. Track loading states for phased rendering</div>
                    <p class="text-xs text-gray-600 mb-2">Create variables to track both the overall loading state and
                        whether images are ready to display. This lets you show data in phases.</p>
                    <ul class="list-disc ml-4 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li><code>isLoading</code> controls whether to show skeleton screens</li>
                        <li><code>showImages</code> controls when to reveal Pokemon images</li>
                        <li><code>errorMessage</code> stores any error text</li>
                        <li><code>allPokemon</code> holds your Pokemon data</li>
                    </ul>
                    <pre
                        class="code-block text-xs sm:text-sm font-mono text-gray-800 w-full max-w-full overflow-x-auto">@@code {
    protected bool isLoading = true;
    protected bool showImages = false;
    protected string? errorMessage;
    protected List&lt;PokemonItem&gt; allPokemon = new();
}</pre>
                </div>

                <div class="bg-gray-100 border border-gray-200 rounded-lg p-4">
                    <div class="text-xs text-gray-500 mb-1">Components/Pages/Pokemon/Loading.razor</div>
                    <div class="text-xs text-gray-500 mb-1">2. Load data in phases for better UX</div>
                    <p class="text-xs text-gray-600 mb-2">First show skeleton screens, then load and display the data,
                        and finally reveal images after a brief delay. This creates a smooth, progressive loading
                        experience.</p>
                    <ul class="list-disc ml-4 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li>Phase 1: Show skeleton screens (animate-pulse effect)</li>
                        <li>Phase 2: Fetch data and display names immediately</li>
                        <li>Phase 3: Reveal images after short delay for smoother feel</li>
                        <li>try-catch-finally ensures errors don't crash the app</li>
                    </ul>
                    <pre
                        class="code-block text-xs sm:text-sm font-mono text-gray-800 w-full max-w-full overflow-x-auto">protected override async Task OnInitializedAsync()
{
    try
    {
        isLoading = true;
        showImages = false;
        errorMessage = null;

        // Initial delay to show skeleton loading
        await Task.Delay(1500);

        var client = HttpClientFactory.CreateClient("PokeApi");
        var response = await client.GetFromJsonAsync&lt;PokemonListResponse&gt;(
            "pokemon?limit=151"
        );

        allPokemon = response?.Results ?? new();
        isLoading = false; // Names render immediately

        // Extra delay before images load
        await Task.Delay(1500);
        showImages = true;
    }
    catch (HttpRequestException ex)
    {
        errorMessage = $"Network error: {ex.Message}";
    }
    catch (Exception ex)
    {
        errorMessage = $"Failed to load Pokemon: {ex.Message}";
    }
    finally
    {
        isLoading = false;
    }
}</pre>
                </div>

                <div class="bg-gray-100 border border-gray-200 rounded-lg p-4">
                    <div class="text-xs text-gray-500 mb-1">Components/Pages/Pokemon/Loading.razor</div>
                    <div class="text-xs text-gray-500 mb-1">3. Create animated skeleton cards</div>
                    <p class="text-xs text-gray-600 mb-2">Build placeholder cards that mirror your actual layout. The
                        animate-pulse class makes them gently pulse, showing users that something is loading.</p>
                    <ul class="list-disc ml-4 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li>Loop to create 3 skeleton cards</li>
                        <li>Use bg-slate-100/200 for placeholder elements</li>
                        <li>animate-pulse makes the whole card pulse smoothly</li>
                        <li>Match the real card layout exactly for seamless transition</li>
                    </ul>
                    <pre
                        class="code-block text-xs sm:text-sm font-mono text-gray-800 w-full max-w-full overflow-x-auto">@@if (isLoading)
{
    &lt;div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"&gt;
        @@for (int i = 0; i &lt; 3; i++)
        {
            &lt;div class="bg-white border border-gray-200 rounded-2xl p-6 
                        shadow-sm animate-pulse flex flex-col"&gt;
                &lt;div class="w-full aspect-square bg-slate-100 rounded-xl mb-4"&gt;&lt;/div&gt;
                &lt;div class="h-px w-full bg-slate-100 mb-4"&gt;&lt;/div&gt;
                &lt;div class="h-3 bg-slate-200 rounded w-1/4 mb-2"&gt;&lt;/div&gt;
                &lt;div class="h-4 bg-slate-200 rounded w-1/2"&gt;&lt;/div&gt;
            &lt;/div&gt;
        }
    &lt;/div&gt;
}</pre>
                </div>

                <div class="bg-gray-100 border border-gray-200 rounded-lg p-4">
                    <div class="text-xs text-gray-500 mb-1">Components/Pages/Pokemon/Loading.razor</div>
                    <div class="text-xs text-gray-500 mb-1">4. Conditionally show images when ready</div>
                    <p class="text-xs text-gray-600 mb-2">Check the showImages flag to decide whether to display the
                        actual Pokemon image or keep showing a placeholder. This creates a smooth two-phase reveal.</p>
                    <ul class="list-disc ml-4 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li>If showImages is true, display the img tag with Pokemon artwork</li>
                        <li>If false, show a gray placeholder that matches the skeleton</li>
                        <li>Names and IDs show immediately when isLoading becomes false</li>
                        <li>Images fade in later when showImages switches to true</li>
                    </ul>
                    <pre
                        class="code-block text-xs sm:text-sm font-mono text-gray-800 w-full max-w-full overflow-x-auto">@@if (showImages)
{
    &lt;img src="@@GetPokemonImageUrl(pokemon.Url)" alt="@@pokemon.Name"
        class="w-full aspect-square object-contain mb-4 
               transition-opacity duration-300 opacity-100"
        loading="lazy" /&gt;
}
else
{
    &lt;div class="w-full aspect-square bg-slate-100 rounded-xl mb-4"&gt;&lt;/div&gt;
}</pre>
                </div>

                <div class="bg-gray-100 border border-gray-200 rounded-lg p-4">
                    <div class="text-xs text-gray-500 mb-1">Components/Pages/Pokemon/Loading.razor</div>
                    <div class="text-xs text-gray-500 mb-1">5. Build helper methods for Pokemon data</div>
                    <p class="text-xs text-gray-600 mb-2">Extract the Pokemon ID from its URL and build the image URL
                        using that ID. These helpers keep your markup clean and reusable.</p>
                    <ul class="list-disc ml-4 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li>GetPokemonId extracts the ID from the PokeAPI URL</li>
                        <li>GetPokemonImageUrl builds the official artwork URL</li>
                        <li>PadLeft(3, '0') formats IDs like "001", "025", "151"</li>
                        <li>These methods make your code cleaner and easier to maintain</li>
                    </ul>
                    <pre
                        class="code-block text-xs sm:text-sm font-mono text-gray-800 w-full max-w-full overflow-x-auto">private string GetPokemonId(string url)
{
    var parts = url.TrimEnd('/').Split('/');
    return parts[^1];
}

private string GetPokemonImageUrl(string url)
{
    var id = GetPokemonId(url);
    return $"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/{id}.png";
}</pre>
                </div>

                <div class="bg-gray-100 border border-gray-200 rounded-lg p-4">
                    <div class="text-xs text-gray-500 mb-1">Components/Pages/Pokemon/Loading.razor</div>
                    <div class="text-xs text-gray-500 mb-1">6. Define your data model classes</div>
                    <p class="text-xs text-gray-600 mb-2">Create simple classes that match the structure of the PokeAPI
                        response. This tells C# what the JSON data looks like so it can deserialize it properly.</p>
                    <ul class="list-disc ml-4 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li>PokemonListResponse wraps the entire API response</li>
                        <li>Results property holds the list of Pokemon</li>
                        <li>PokemonItem represents a single Pokemon with name and URL</li>
                        <li>These classes enable GetFromJsonAsync to work its magic</li>
                    </ul>
                    <pre
                        class="code-block text-xs sm:text-sm font-mono text-gray-800 w-full max-w-full overflow-x-auto">public class PokemonListResponse
{
    public List&lt;PokemonItem&gt; Results { get; set; } = new();
}

public class PokemonItem
{
    public string Name { get; set; } = "";
    public string Url { get; set; } = "";
}</pre>
                </div>

                <div class="bg-gray-100 border border-gray-200 rounded-lg p-4">
                    <div class="text-xs text-gray-500 mb-1">Components/Pages/Pokemon/Loading.razor</div>
                    <div class="text-xs text-gray-500 mb-1">7. Add a retry/refresh button</div>
                    <p class="text-xs text-gray-600 mb-2">Give users a way to reload the data and see the loading
                        sequence again. This is useful for testing and for retrying after errors.</p>
                    <ul class="list-disc ml-4 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li>RetryLoad method re-runs OnInitializedAsync to fetch data again</li>
                        <li>StateHasChanged forces the UI to update immediately</li>
                        <li>Users can click to see the skeleton → names → images sequence again</li>
                        <li>Same method works for error recovery and testing</li>
                    </ul>
                    <pre
                        class="code-block text-xs sm:text-sm font-mono text-gray-800 w-full max-w-full overflow-x-auto">protected async Task RetryLoad()
{
    await OnInitializedAsync();
    StateHasChanged();
}

&lt;!-- Button in your markup --&gt;
&lt;button @@onclick="RetryLoad"
    class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg"&gt;
     Refresh
&lt;/button&gt;</pre>
                </div>
            </div>
        </div>

        <!-- Important Notes & Tips (White Card) -->
        <div class="bg-white rounded-xl p-6 border border-gray-200 mb-6">
            <h2 class="text-xl sm:text-2xl font-semibold text-gray-800 mb-4">📝 Important Notes & Tips</h2>

            <div class="space-y-3">
                <!-- Pro Tips (Blue) -->
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <h3 class="text-sm font-bold text-blue-900 mb-3">💡 Pro Tips</h3>
                    <div class="space-y-4">
                        <div>
                            <p class="text-sm font-semibold text-blue-900 mb-2">Match skeleton to real layout</p>
                            <p class="text-xs text-blue-800">Your skeleton cards should look exactly like your real
                                cards - same size, same spacing, same structure. This makes the transition seamless.
                                Users shouldn't notice a jarring shift when the real content appears.</p>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-blue-900 mb-2">Use phased loading for better UX</p>
                            <p class="text-xs text-blue-800">Don't wait for everything before showing anything! Load and
                                display text data first (it's fast), then reveal images afterward (they're slower).
                                This makes your app feel incredibly responsive even on slow connections.</p>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-blue-900 mb-2">Test with network throttling</p>
                            <p class="text-xs text-blue-800">Your skeleton loading might look perfect on fast WiFi but
                                flash by too quickly for users to see. Use browser dev tools to slow down your network
                                ("Slow 3G" mode) and verify your loading states actually show up.</p>
                        </div>
                    </div>
                </div>

                <!-- Troubleshooting (Yellow) -->
                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                    <h3 class="text-sm font-bold text-yellow-900 mb-2">⚠️ Troubleshooting</h3>
                    <ul class="list-disc ml-6 text-sm text-yellow-900 space-y-1">
                        <li><strong>Skeleton doesn't pulse:</strong> Make sure you added the animate-pulse class to your
                            skeleton container div. Without it, the placeholders are static.</li>
                        <li><strong>Images show immediately with names:</strong> Check that showImages starts as false
                            and only switches to true after your delay. The phased loading relies on this flag.</li>
                        <li><strong>Layout shifts when data loads:</strong> Your skeleton structure doesn't match your
                            real cards. Use the same grid classes, padding, and aspect ratios for both.</li>
                        <li><strong>Image URLs broken:</strong> Verify GetPokemonId is extracting the ID correctly
                            (check with console logging). The URL should end with the Pokemon number.</li>
                        <li><strong>Can't see loading states:</strong> Add longer Task.Delay times during development to
                            see the transitions clearly. Remove or reduce them for production.</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- How to do it (Gradient Banner) -->
        <div class="bg-gradient-to-r from-gray-100 to-blue-100 rounded-2xl p-5 sm:p-6 mb-6">
            <h2 class="text-xl sm:text-2xl font-semibold text-gray-800 mb-4">🛠️ How to do it</h2>
            <ol class="list-decimal ml-5 space-y-2 text-gray-700 text-sm sm:text-base">
                <li>
                    <strong>Create your component:</strong>
                    Make a new file called <code>Loading.razor</code> in your <code>Components/Pages/Pokemon</code>
                    folder with the route /pokemon/loading
                </li>
                <li>
                    <strong>Add state variables:</strong>
                    Create <code>isLoading</code>, <code>showImages</code>, <code>errorMessage</code>, and
                    <code>allPokemon</code> list
                </li>
                <li>
                    <strong>Build skeleton cards:</strong>
                    Create 3 placeholder cards with gray boxes and animate-pulse to show while loading
                </li>
                <li>
                    <strong>Implement phased loading:</strong>
                    Load data first (show names immediately), then reveal images after a short delay
                </li>
                <li>
                    <strong>Add helper methods:</strong>
                    Create GetPokemonId and GetPokemonImageUrl to extract IDs and build image URLs
                </li>
                <li>
                    <strong>Handle errors and empty states:</strong>
                    Add else-if blocks for error messages with retry buttons and "no data" messages
                </li>
                <li>
                    <strong>Test with throttling:</strong>
                    Use browser dev tools to slow your network and see the skeleton loading in action
                </li>
            </ol>
        </div>

        <!-- Live Demo (Optional) -->
        <div class="bg-black/3 rounded-2xl p-6 mb-6">
            <h2 class="text-2xl font-semibold text-gray-800 mb-4">🎬 Live Demo</h2>
            <p class="text-sm text-gray-600 mb-4">Watch the skeleton loading in action! First you'll see pulsing
                placeholder cards, then Pokemon names appear, and finally images fade in. Click refresh to see it again!
            </p>

            <div class="bg-white rounded-2xl border border-gray-200 p-6">
                @if (isLoading)
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        @for (int i = 0; i < 3; i++)
                        {
                            <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm animate-pulse flex flex-col">
                                <div class="w-full aspect-square bg-slate-100 rounded-xl mb-4"></div>
                                <div class="h-px w-full bg-slate-100 mb-4"></div>
                                <div class="h-3 bg-slate-200 rounded w-1/4 mb-2"></div>
                                <div class="h-4 bg-slate-200 rounded w-1/2"></div>
                            </div>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="bg-red-50 border-2 border-red-200 rounded-xl p-6">
                        <h3 class="text-red-800 font-semibold mb-2">⚠️ Error</h3>
                        <p class="text-red-700">@errorMessage</p>
                        <button @onclick="RetryLoad"
                            class="mt-4 px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors">
                            Retry
                        </button>
                    </div>
                }
                else if (livePokemon.Count == 0)
                {
                    <div class="text-center p-12 text-gray-500">
                        <p class="text-lg font-medium">No Pokemon found</p>
                        <p class="text-sm mt-2">Try again later or check your connection.</p>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        @foreach (var pokemon in livePokemon.Take(3))
                        {
                            <div
                                class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col">
                                @if (showImages)
                                {
                                    <img src="@GetPokemonImageUrl(pokemon.Url)" alt="@pokemon.Name"
                                        class="w-full aspect-square object-contain mb-4 transition-opacity duration-300 opacity-100"
                                        loading="lazy" />
                                }
                                else
                                {
                                    <div class="w-full aspect-square bg-slate-100 rounded-xl mb-4"></div>
                                }
                                <div class="h-px w-full bg-slate-100 mb-4"></div>
                                <p class="text-xs text-slate-500 mb-1">#@GetPokemonId(pokemon.Url).PadLeft(3, '0')</p>
                                <p class="text-base font-semibold text-sky-900 capitalize">
                                    @pokemon.Name
                                </p>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="flex justify-center mt-4">
                <button @onclick="RefreshDemo"
                    class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors flex items-center gap-2">
                    <span>🔄</span> Refresh to See Loading Again
                </button>
            </div>

            <p class="text-xs text-gray-600 mt-4 text-center">💡 This live demo shows the exact skeleton loading and
                phased reveal pattern from the code examples above.</p>
        </div>

        <!-- Mark Complete (Green Card) -->
