                <pre data-code-title="Razor (Cards.razor)"
                    class="code-block text-xs sm:text-sm font-mono text-gray-800 w-full max-w-full overflow-x-auto">@@page "/pokemon/cards"
@@inject IHttpClientFactory HttpClientFactory
@@rendermode InteractiveServer

&lt;h3 class="text-xl font-semibold mb-4"&gt;Polished Pokemon Grid&lt;/h3&gt;

@@if (isLoading)
{
    &lt;div class="flex items-center justify-center p-12"&gt;
        &lt;div class="animate-spin rounded-full h-12 w-12 border-4 
                    border-blue-600 border-t-transparent"&gt;&lt;/div&gt;
        &lt;span class="ml-3 text-gray-600"&gt;Loading Pokemon...&lt;/span&gt;
    &lt;/div&gt;
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    &lt;div class="bg-red-50 border-2 border-red-200 rounded-xl p-6"&gt;
        &lt;p class="text-red-700"&gt;@@errorMessage&lt;/p&gt;
    &lt;/div&gt;
}
else
{
    &lt;!-- Responsive grid: 2 cols mobile, 3 tablet, 4 laptop, 5 desktop --&gt;
    &lt;div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4"&gt;
        @@foreach (var pokemon in currentPagePokemon)
        {
            int id = GetPokemonId(pokemon.Url);
            
            &lt;div class="border-2 border-gray-200 rounded-xl overflow-hidden 
                        hover:border-blue-400 hover:shadow-xl 
                        transition-all duration-200 cursor-pointer"&gt;
                
                &lt;!-- Square image container --&gt;
                &lt;div class="aspect-square bg-gradient-to-br from-gray-50 to-gray-100"&gt;
                    &lt;img src="@@GetSpriteUrl(id)" 
                         class="w-full h-full object-contain p-2
                                hover:scale-110 transition-transform duration-300" 
                         alt="@@pokemon.Name" 
                         loading="lazy" /&gt;
                &lt;/div&gt;
                
                &lt;!-- Info section --&gt;
                &lt;div class="p-3 bg-white"&gt;
                    &lt;span class="text-xs text-gray-500 font-mono"&gt;
                        #@@id.ToString("D3")
                    &lt;/span&gt;
                    &lt;p class="font-semibold text-gray-800 capitalize 
                              hover:text-blue-600 transition-colors"&gt;
                        @@pokemon.Name
                    &lt;/p&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        }
    &lt;/div&gt;

    &lt;!-- Pagination --&gt;
    &lt;div class="flex items-center justify-between mt-6"&gt;
        &lt;button @@onclick="PreviousPage" 
                disabled="@@(currentPage == 1)"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg
                       hover:bg-blue-700 transition-colors
                       disabled:opacity-50 disabled:cursor-not-allowed"&gt;
            ← Previous
        &lt;/button&gt;
        
        &lt;span class="text-sm text-gray-600"&gt;
            Page @@currentPage of @@totalPages
        &lt;/span&gt;
        
        &lt;button @@onclick="NextPage" 
                disabled="@@(currentPage >= totalPages)"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg
                       hover:bg-blue-700 transition-colors
                       disabled:opacity-50 disabled:cursor-not-allowed"&gt;
            Next →
        &lt;/button&gt;
    &lt;/div&gt;
}</pre>
