            <div class="bg-gray-100 border border-gray-200 rounded-lg p-4 overflow-x-auto mb-4">
                <div class="text-xs text-gray-500 mb-1">Components/Pages/Pokemon/Cards.razor.cs</div>
                <p class="text-xs text-gray-600 mb-2">Here's the complete code-behind file with all the logic for
                    fetching Pokemon, pagination, and helper methods.</p>
                <ul class="list-disc ml-4 mb-3 text-[11px] text-gray-600 space-y-1">
                    <li>Manages loading state, error handling, and Pokemon data</li>
                    <li>Implements pagination with Previous/Next navigation</li>
                    <li>Includes helper methods to extract IDs and build image URLs</li>
                    <li>Defines data models that match the PokeAPI response</li>
                </ul>
                <pre data-code-title="C# (Cards.razor.cs)"
                    class="code-block text-xs sm:text-sm font-mono text-gray-800 w-full max-w-full overflow-x-auto">using Microsoft.AspNetCore.Components;

namespace PokemonCollector.Components.Pages.Pokemon;

public partial class CardsBase : ComponentBase
{
    [Inject] protected IHttpClientFactory HttpClientFactory { get; set; } = default!;

    protected bool isLoading = true;
    protected string? errorMessage;
    protected List&lt;PokemonItem&gt; allPokemon = new();
    protected List&lt;PokemonItem&gt; currentPagePokemon = new();
    
    protected int currentPage = 1;
    protected int pageSize = 20;
    protected int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var client = HttpClientFactory.CreateClient("PokeApi");
            var response = await client.GetFromJsonAsync&lt;PokemonListResponse&gt;("pokemon?limit=151");

            allPokemon = response?.Results ?? new List&lt;PokemonItem&gt;();
            totalPages = (int)Math.Ceiling(allPokemon.Count / (double)pageSize);
            UpdateCurrentPage();
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Network error: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load Pokemon: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    protected void PreviousPage()
    {
        if (currentPage &gt; 1)
        {
            currentPage--;
            UpdateCurrentPage();
        }
    }

    protected void NextPage()
    {
        if (currentPage &lt; totalPages)
        {
            currentPage++;
            UpdateCurrentPage();
        }
    }

    private void UpdateCurrentPage()
    {
        currentPagePokemon = allPokemon
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    protected static int GetPokemonId(string url)
    {
        var parts = url.TrimEnd('/').Split('/');
        return int.Parse(parts[^1]);
    }

    protected static string GetSpriteUrl(int id)
    {
        return $"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/{id}.png";
    }

    protected class PokemonListResponse
    {
        public List&lt;PokemonItem&gt; Results { get; set; } = new();
    }

    protected class PokemonItem
    {
        public string Name { get; set; } = "";
        public string Url { get; set; } = "";
    }
}</pre>
