@page "/pokemon-examples/demo-search"
@rendermode InteractiveServer
@inherits PokemonSearchExampleBase

<PageTitle>Pokemon Search Demo</PageTitle>

<div class="min-h-screen py-8 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
        <h3 class="text-2xl font-semibold mb-6 text-gray-900">Pokemon Search & Details</h3>

        <!-- Search input -->
        <div class="mb-6">
            <input type="text" @bind="searchQuery" @bind:event="oninput" @bind:after="OnSearchChanged"
                placeholder="Search Pokemon by name..." class="w-full px-4 py-2 border-2 border-gray-200 rounded-lg
                          focus:border-blue-400 focus:outline-none transition-colors" />

            <p class="text-sm text-gray-600 mt-2">
                Found @FilteredPokemon.Count Pokemon
            </p>
        </div>

        @if (isLoading)
        {
            <div class="flex items-center justify-center p-12">
                <div class="animate-spin rounded-full h-12 w-12 border-4 border-blue-600 border-t-transparent"></div>
                <span class="ml-3 text-gray-600">Loading Pokemon...</span>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="bg-red-50 border-2 border-red-200 rounded-xl p-6">
                <p class="text-red-700">@errorMessage</p>
            </div>
        }
        else
        {
            <!-- Pokemon grid -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                @foreach (var pokemon in CurrentPagePokemon)
                {
                    int id = GetPokemonId(pokemon.Url);

                    <div @onclick="@(() => ShowDetails(id))" class="border-2 border-gray-200 rounded-xl overflow-hidden 
                                        hover:border-blue-400 hover:shadow-xl 
                                        transition-all duration-200 cursor-pointer">

                        <div class="aspect-square bg-gradient-to-br from-gray-50 to-gray-100">
                            <img src="@GetSpriteUrl(id)" class="w-full h-full object-contain p-2
                                                hover:scale-110 transition-transform duration-300" alt="@pokemon.Name"
                                loading="lazy" />
                        </div>

                        <div class="p-3 bg-white">
                            <span class="text-xs text-gray-500 font-mono">
                                #@id.ToString("D3")
                            </span>
                            <p class="font-semibold text-gray-800 capitalize 
                                              hover:text-blue-600 transition-colors">
                                @pokemon.Name
                            </p>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            <div class="flex items-center justify-between mt-6">
                <button @onclick="PreviousPage" disabled="@(currentPage == 1)" class="px-4 py-2 bg-blue-600 text-white rounded-lg
                                   hover:bg-blue-700 transition-colors
                                   disabled:opacity-50 disabled:cursor-not-allowed">
                    ← Previous
                </button>

                <span class="text-sm text-gray-600">
                    Page @currentPage of @totalPages
                </span>

                <button @onclick="NextPage" disabled="@(currentPage >= totalPages)" class="px-4 py-2 bg-blue-600 text-white rounded-lg
                                   hover:bg-blue-700 transition-colors
                                   disabled:opacity-50 disabled:cursor-not-allowed">
                    Next →
                </button>
            </div>
        }
    </div>
</div>

<!-- Modal for Pokemon details -->
@if (selectedPokemon != null)
{
    <div @onclick="CloseModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">

        <div @onclick:stopPropagation class="bg-white rounded-2xl shadow-2xl p-6 max-w-md w-full">

            <!-- Close button -->
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-2xl font-bold capitalize">@selectedPokemon.Name</h2>
                <button @onclick="CloseModal" class="text-gray-500 hover:text-gray-700 text-2xl">
                    ✕
                </button>
            </div>

            <!-- Pokemon sprite -->
            <img src="@GetSpriteUrl(selectedPokemon.Id)" class="w-48 h-48 mx-auto" alt="@selectedPokemon.Name" />

            <!-- Stats -->
            <div class="mt-4 space-y-2">
                <p class="text-sm">
                    <strong>Height:</strong> @(selectedPokemon.Height / 10.0)m
                </p>
                <p class="text-sm">
                    <strong>Weight:</strong> @(selectedPokemon.Weight / 10.0)kg
                </p>
                <p class="text-sm">
                    <strong>Base Experience:</strong> @selectedPokemon.Base_Experience
                </p>
            </div>

            <!-- Types -->
            <div class="mt-4">
                <p class="text-sm font-semibold mb-2">Types:</p>
                <div class="flex gap-2">
                    @foreach (var type in selectedPokemon.Types)
                    {
                        <span class="px-3 py-1 bg-blue-100 text-blue-700 
                                             rounded-full text-sm capitalize">
                            @type.Type.Name
                        </span>
                    }
                </div>
            </div>

            <!-- Abilities -->
            <div class="mt-4">
                <p class="text-sm font-semibold mb-2">Abilities:</p>
                <div class="flex flex-wrap gap-2">
                    @foreach (var ability in selectedPokemon.Abilities)
                    {
                        <span class="px-3 py-1 bg-green-100 text-green-700 
                                             rounded-full text-sm capitalize">
                            @ability.Ability.Name
                        </span>
                    }
                </div>
            </div>

            <!-- Close button -->
            <button @onclick="CloseModal" class="w-full mt-6 px-4 py-2 bg-blue-600 hover:bg-blue-700 
                               text-white rounded-lg transition-colors">
                Close
            </button>
        </div>
    </div>
}