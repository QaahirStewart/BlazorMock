@page "/trucking-examples/step6"
@inherits ExampleBase
@rendermode InteractiveServer

<PageTitle>Trucking Step 6: Routing & Navigation - Example</PageTitle>

<div class="min-h-screen py-8 rounded-4xl bg-gray-50">
    <div class="w-full mx-auto px-4 max-w-5xl">
        <!-- Header -->
        <div class="mb-8">
            <a href="/trucking-guide"
                class="inline-flex items-center gap-2 text-sm sm:text-base text-blue-600 hover:text-blue-700 mb-4">
                <span>←</span> Back to Trucking Guide
            </a>
            <h1 class="text-4xl font-bold text-gray-900 mb-4">
                🚦 Step 6: Routing & Navigation
            </h1>
            <p class="text-xl text-gray-600">
                Time to connect the dots! You'll learn how to add routes to your pages, build navigation menus with
                active state highlighting, and navigate programmatically from your code.
            </p>
        </div>

        <!-- What You'll Learn -->
        <div class="bg-gradient-to-r from-gray-100 to-blue-100 rounded-2xl p-5 sm:p-6 mb-6">
            <h2 class="text-xl sm:text-2xl font-semibold text-gray-800 mb-4">What You'll Learn</h2>
            <p class="text-gray-700 mb-4 text-sm sm:text-base">
                Every multi-page app needs navigation! Blazor's routing system is simple yet powerful — you define
                routes with a single line, and navigation "just works" like a single-page app.
            </p>
            <ul class="list-disc ml-6 text-sm sm:text-base text-gray-700 space-y-2 mb-4">
                <li>Add the <code class="px-1 rounded bg-gray-100">@@page</code> directive to make any component a
                    routable page</li>
                <li>Use <code class="px-1 rounded bg-gray-100">NavLink</code> instead of <code
                        class="px-1 rounded bg-gray-100">&lt;a&gt;</code> tags for automatic active state styling</li>
                <li>Build a navigation menu that highlights the current page</li>
                <li>Navigate from C# code using <code class="px-1 rounded bg-gray-100">NavigationManager</code> (great
                    for after form submits!)</li>
                <li>Pass data between pages using route parameters</li>
            </ul>
            <div class="mt-2 pt-3 border-t border-blue-200">
                <p class="text-xs sm:text-sm text-gray-700 mb-2">
                    <strong>💡 Key Concepts:</strong> @@page directive, NavLink, NavigationManager, Route Parameters,
                    Active State
                </p>
                <div class="flex flex-wrap items-center gap-2">
                    <span class="text-xs sm:text-sm text-gray-600">→ Related tips:</span>
                    <a href="/tips#routing"
                        class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-[11px] sm:text-xs font-medium hover:bg-blue-200 transition-colors">Blazor
                        Routing</a>
                    <a href="/tips#navigation"
                        class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-[11px] sm:text-xs font-medium hover:bg-blue-200 transition-colors">Navigation</a>
                </div>
            </div>
        </div>

        <!-- Code Example: page Directive -->
        <div class="bg-white rounded-xl p-6 border border-gray-200 mb-6">
            <div class="mb-3">
                <p class="text-xs uppercase tracking-wide text-gray-500 font-semibold">Code Example 1</p>
                <h3 class="text-lg font-semibold text-gray-800 mt-1">The @@page Directive</h3>
            </div>
            <p class="text-xs text-gray-600 mb-3">
                Map routes to components using the @@page directive. Multiple routes can point to the same component.
            </p>
            <ul class="list-disc pl-5 text-[11px] text-gray-600 space-y-1 mb-4">
                <li>Use <code class="px-1 rounded bg-gray-100">@@page "/route"</code> at the top of your component</li>
                <li>Multiple @@page directives allow multiple routes to the same component</li>
                <li>Route constraints like <code class="px-1 rounded bg-gray-100">{id:int}</code> ensure type safety
                </li>
            </ul>
            <div class="bg-gray-100 rounded-lg p-4 overflow-x-auto">
                <pre data-code-title="Razor (@@page Directive)">
&lt;!-- Components/Pages/Drivers.razor --&gt;
@@page "/drivers"

&lt;div class="min-h-screen py-8 bg-gray-50"&gt;
    &lt;div class="max-w-5xl mx-auto px-4"&gt;
        &lt;h1 class="text-3xl font-bold text-gray-900 mb-6"&gt;🚗 Drivers&lt;/h1&gt;
        &lt;p class="text-gray-600"&gt;Manage your truck drivers here.&lt;/p&gt;
    &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Components/Pages/Home.razor --&gt;
@@page "/"
@@page "/home"

&lt;div class="min-h-screen py-8 bg-gray-50"&gt;
    &lt;div class="max-w-5xl mx-auto px-4"&gt;
        &lt;h1 class="text-3xl font-bold text-gray-900 mb-6"&gt;🏠 Dashboard&lt;/h1&gt;
        &lt;p class="text-gray-600"&gt;Accessible via both / and /home routes.&lt;/p&gt;
    &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Components/Pages/DriverDetails.razor --&gt;
@@page "/driver/{driverId:int}"
@@inject NavigationManager Navigation

@@code {
    [Parameter]
    public int DriverId { get; set; }
}

&lt;h1&gt;Driver Details: #@@DriverId&lt;/h1&gt;
</pre>
            </div>
        </div>

        <!-- Code Example: NavLink Component -->
        <div class="bg-white rounded-xl p-6 border border-gray-200 mb-6">
            <div class="mb-3">
                <p class="text-xs uppercase tracking-wide text-gray-500 font-semibold">Code Example 2</p>
                <h3 class="text-lg font-semibold text-gray-800 mt-1">NavLink with Active State</h3>
            </div>
            <p class="text-xs text-gray-600 mb-3">
                NavLink generates anchor tags with automatic active state styling based on the current URL.
            </p>
            <ul class="list-disc pl-5 text-[11px] text-gray-600 space-y-1 mb-4">
                <li><code class="px-1 rounded bg-gray-100">Match="NavLinkMatch.All"</code> requires exact URL match (use
                    for home page)</li>
                <li><code class="px-1 rounded bg-gray-100">ActiveClass</code> defines custom CSS for active links</li>
                <li>Default behavior uses prefix matching for nested routes</li>
            </ul>
            <div class="bg-gray-100 rounded-lg p-4 overflow-x-auto">
                <pre data-code-title="Razor (NavLink Component)">
&lt;nav class="bg-blue-600 text-white shadow-lg"&gt;
    &lt;div class="max-w-7xl mx-auto px-4"&gt;
        &lt;div class="flex items-center justify-between h-16"&gt;
            &lt;div class="text-xl font-bold"&gt;Trucking Schedule&lt;/div&gt;
            
            &lt;div class="flex gap-4"&gt;
                &lt;NavLink href="/" Match="NavLinkMatch.All"
                         class="px-3 py-2 rounded hover:bg-blue-700"
                         ActiveClass="bg-blue-800 font-semibold"&gt;
                    Home
                &lt;/NavLink&gt;
                
                &lt;NavLink href="/demo/trucking/drivers"
                         class="px-3 py-2 rounded hover:bg-blue-700"
                         ActiveClass="bg-blue-800 font-semibold"&gt;
                    Drivers
                &lt;/NavLink&gt;
                
                &lt;NavLink href="/demo/trucking/trucks"
                         class="px-3 py-2 rounded hover:bg-blue-700"
                         ActiveClass="bg-blue-800 font-semibold"&gt;
                    Trucks
                &lt;/NavLink&gt;
                
                &lt;NavLink href="/demo/trucking/routes"
                         class="px-3 py-2 rounded hover:bg-blue-700"
                         ActiveClass="bg-blue-800 font-semibold"&gt;
                    Routes
                &lt;/NavLink&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/nav&gt;
</pre>
            </div>
        </div>

        <!-- Code Example: NavigationManager -->
        <div class="bg-white rounded-xl p-6 border border-gray-200 mb-6">
            <div class="mb-3">
                <p class="text-xs uppercase tracking-wide text-gray-500 font-semibold">Code Example 3</p>
                <h3 class="text-lg font-semibold text-gray-800 mt-1">Programmatic Navigation</h3>
            </div>
            <p class="text-xs text-gray-600 mb-3">
                Use NavigationManager to navigate from C# code, handle redirects, and listen to URL changes.
            </p>
            <ul class="list-disc pl-5 text-[11px] text-gray-600 space-y-1 mb-4">
                <li><code class="px-1 rounded bg-gray-100">NavigateTo(url)</code> navigates to a new URL</li>
                <li><code class="px-1 rounded bg-gray-100">forceLoad: true</code> forces full page reload</li>
                <li><code class="px-1 rounded bg-gray-100">LocationChanged</code> event detects navigation</li>
            </ul>
            <div class="bg-gray-100 rounded-lg p-4 overflow-x-auto">
                <pre data-code-title="C# (NavigationManager)">
@@page "/driver-form"
@@inject NavigationManager Navigation

&lt;button @@onclick="SaveAndNavigate"
        class="px-6 py-3 bg-green-600 text-white rounded-lg"&gt;
    Save &amp; Go to Drivers
&lt;/button&gt;

&lt;button @@onclick="GoBack"
        class="px-6 py-3 border border-gray-300 rounded-lg"&gt;
    Cancel
&lt;/button&gt;

@@code {
    private void SaveAndNavigate()
    {
        // Save data...
        
        // Navigate to drivers list
        Navigation.NavigateTo("/drivers");
    }

    private void GoBack()
    {
        // Navigate back to previous page
        Navigation.NavigateTo("/guide");
    }

    protected override void OnInitialized()
    {
        // Subscribe to location changes
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        Console.WriteLine($"Navigated to: {e.Location}");
        StateHasChanged(); // Refresh UI if needed
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
</pre>
            </div>
        </div>

        <!-- Step-by-step breakdown -->
        <div class="bg-white rounded-xl p-6 border border-gray-200 mb-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4">🔨 Step-by-Step: Set Up Navigation</h2>
            <p class="text-sm text-gray-600 mb-4">
                Let's add routing and navigation to your trucking app. We'll create multiple pages and connect them
                together!
            </p>

            <div class="grid gap-4">
                <!-- Step 1 -->
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                    <div class="flex items-center gap-2 mb-2">
                        <span
                            class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs flex items-center justify-center font-bold">1</span>
                        <span class="text-sm font-semibold text-gray-800">Add @@page directive to make a component
                            routable</span>
                    </div>
                    <p class="text-xs text-gray-600 mb-2 ml-8">
                        The <code class="px-1 rounded bg-gray-100">@@page</code> directive MUST be at the very top of
                        your file. It tells Blazor "this component is a page at this URL."
                    </p>
                    <ul class="list-disc ml-12 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li>Put it on line 1, before any other directives</li>
                        <li>The route must start with a forward slash <code class="px-1 rounded bg-gray-100">/</code>
                        </li>
                        <li>One component can have multiple @@page directives for different URLs</li>
                    </ul>
                    <pre
                        class="code-block text-xs font-mono text-gray-800 ml-8 bg-gray-100 rounded p-2 overflow-x-auto">@@page "/drivers"
@@* rest of your component... *@@</pre>
                </div>

                <!-- Step 2 -->
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                    <div class="flex items-center gap-2 mb-2">
                        <span
                            class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs flex items-center justify-center font-bold">2</span>
                        <span class="text-sm font-semibold text-gray-800">Create your page components</span>
                    </div>
                    <p class="text-xs text-gray-600 mb-2 ml-8">
                        Create separate .razor files for each page in your app. Put them in <code
                            class="px-1 rounded bg-gray-100">Components/Pages/</code>.
                    </p>
                    <ul class="list-disc ml-12 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li><code class="px-1 rounded bg-gray-100">Components/Pages/Drivers.razor</code> → @@page
                            "/drivers"</li>
                        <li><code class="px-1 rounded bg-gray-100">Components/Pages/Trucks.razor</code> → @@page
                            "/trucks"</li>
                        <li><code class="px-1 rounded bg-gray-100">Components/Pages/Routes.razor</code> → @@page
                            "/routes"</li>
                    </ul>
                </div>

                <!-- Step 3 -->
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                    <div class="flex items-center gap-2 mb-2">
                        <span
                            class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs flex items-center justify-center font-bold">3</span>
                        <span class="text-sm font-semibold text-gray-800">Use NavLink instead of &lt;a&gt; for
                            navigation</span>
                    </div>
                    <p class="text-xs text-gray-600 mb-2 ml-8">
                        NavLink is like a smart <code class="px-1 rounded bg-gray-100">&lt;a&gt;</code> tag that
                        automatically adds an "active" class when you're on that page.
                    </p>
                    <ul class="list-disc ml-12 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li>Use <code class="px-1 rounded bg-gray-100">ActiveClass</code> to define what CSS classes to
                            add when active</li>
                        <li>NavLink prevents full page reloads — navigation is instant!</li>
                    </ul>
                    <pre
                        class="code-block text-xs font-mono text-gray-800 ml-8 bg-gray-100 rounded p-2 overflow-x-auto">&lt;NavLink href="/drivers" 
         class="px-3 py-2 rounded hover:bg-blue-700"
         ActiveClass="bg-blue-800 font-bold"&gt;
    Drivers
&lt;/NavLink&gt;</pre>
                </div>

                <!-- Step 4 -->
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                    <div class="flex items-center gap-2 mb-2">
                        <span
                            class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs flex items-center justify-center font-bold">4</span>
                        <span class="text-sm font-semibold text-gray-800">Use Match="NavLinkMatch.All" for the home
                            page</span>
                    </div>
                    <p class="text-xs text-gray-600 mb-2 ml-8">
                        Without this, the home link will be "active" on EVERY page (because "/" matches the start of
                        every URL). Add <code class="px-1 rounded bg-gray-100">Match.All</code> to require an exact
                        match.
                    </p>
                    <pre
                        class="code-block text-xs font-mono text-gray-800 ml-8 bg-gray-100 rounded p-2 overflow-x-auto">&lt;NavLink href="/" Match="NavLinkMatch.All" ActiveClass="bg-blue-800"&gt;
    Home
&lt;/NavLink&gt;</pre>
                </div>

                <!-- Step 5 -->
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                    <div class="flex items-center gap-2 mb-2">
                        <span
                            class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs flex items-center justify-center font-bold">5</span>
                        <span class="text-sm font-semibold text-gray-800">Build your navigation menu in
                            MainLayout.razor</span>
                    </div>
                    <p class="text-xs text-gray-600 mb-2 ml-8">
                        MainLayout wraps every page. Put your nav bar here so it appears on all pages!
                    </p>
                    <pre
                        class="code-block text-xs font-mono text-gray-800 ml-8 bg-gray-100 rounded p-2 overflow-x-auto">&lt;!-- Components/Layout/MainLayout.razor --&gt;
&lt;nav class="bg-blue-600 text-white p-4"&gt;
    &lt;NavLink href="/" Match="NavLinkMatch.All"&gt;Home&lt;/NavLink&gt;
    &lt;NavLink href="/drivers"&gt;Drivers&lt;/NavLink&gt;
    &lt;NavLink href="/trucks"&gt;Trucks&lt;/NavLink&gt;
&lt;/nav&gt;

&lt;main&gt;
    @@Body  &lt;!-- Your page content renders here --&gt;
&lt;/main&gt;</pre>
                </div>

                <!-- Step 6 -->
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                    <div class="flex items-center gap-2 mb-2">
                        <span
                            class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs flex items-center justify-center font-bold">6</span>
                        <span class="text-sm font-semibold text-gray-800">Inject NavigationManager for programmatic
                            navigation</span>
                    </div>
                    <p class="text-xs text-gray-600 mb-2 ml-8">
                        Sometimes you need to navigate from C# code (like after saving a form). Inject NavigationManager
                        to do this!
                    </p>
                    <pre
                        class="code-block text-xs font-mono text-gray-800 ml-8 bg-gray-100 rounded p-2 overflow-x-auto">@@inject NavigationManager Navigation

@@code {
    private void SaveAndRedirect()
    {
        // Save your data...
        Navigation.NavigateTo("/drivers");  // Go to drivers page
    }
}</pre>
                </div>

                <!-- Step 7 -->
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                    <div class="flex items-center gap-2 mb-2">
                        <span
                            class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs flex items-center justify-center font-bold">7</span>
                        <span class="text-sm font-semibold text-gray-800">Add route parameters to pass data</span>
                    </div>
                    <p class="text-xs text-gray-600 mb-2 ml-8">
                        Use curly braces in your route to accept parameters. Add <code
                            class="px-1 rounded bg-gray-100">:int</code> to ensure it's a number.
                    </p>
                    <ul class="list-disc ml-12 mb-2 text-[11px] text-gray-600 space-y-1">
                        <li>Parameter names must match your [Parameter] property (case-insensitive)</li>
                        <li>Route constraints like <code class="px-1 rounded bg-gray-100">:int</code>, <code
                                class="px-1 rounded bg-gray-100">:guid</code>, <code
                                class="px-1 rounded bg-gray-100">:bool</code> validate the value</li>
                    </ul>
                    <pre
                        class="code-block text-xs font-mono text-gray-800 ml-8 bg-gray-100 rounded p-2 overflow-x-auto">@@page "/driver/{driverId:int}"

@@code {
    [Parameter]
    public int DriverId { get; set; }  // Automatically populated from URL!
}</pre>
                </div>
            </div>
        </div>

        <!-- Important Notes & Tips -->
        <div class="bg-white rounded-xl p-6 border border-gray-200 mb-6">
            <h2 class="text-2xl font-semibold text-gray-800 mb-4">💡 Important Notes & Tips</h2>

            <!-- Pro Tips -->
            <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-4">
                <h3 class="text-lg font-semibold text-blue-900 mb-3">💎 Pro Tips</h3>
                <ul class="list-disc pl-5 text-blue-800 space-y-2">
                    <li><strong>NavLink vs anchor:</strong> Always use NavLink for internal navigation to get automatic
                        active state and SPA behavior</li>
                    <li><strong>Match.All for home:</strong> Use Match="NavLinkMatch.All" on the home page link to
                        prevent it being active on all routes</li>
                    <li><strong>Route constraints:</strong> Use {id:int}, {name:alpha}, {date:datetime} to validate
                        route parameters at the routing level</li>
                    <li><strong>Query parameters:</strong> Access query strings via NavigationManager.Uri and parse with
                        QueryHelpers from Microsoft.AspNetCore.WebUtilities</li>
                    <li><strong>LocationChanged cleanup:</strong> Always unsubscribe from LocationChanged in Dispose()
                        to prevent memory leaks</li>
                </ul>
            </div>

            <!-- Troubleshooting -->
            <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4">
                <h3 class="text-lg font-semibold text-yellow-900 mb-3">⚠️ Troubleshooting</h3>
                <ul class="list-disc pl-5 text-yellow-800 space-y-2">
                    <li><strong>Home link always active:</strong> Add Match="NavLinkMatch.All" to your home page NavLink
                        to require exact match</li>
                    <li><strong>404 Not Found:</strong> Verify @@page directive is at the very top of the component
                        (before @@inject, @@using, etc.)</li>
                    <li><strong>ActiveClass not working:</strong> Check CSS specificity - ActiveClass may need
                        !important or higher specificity</li>
                    <li><strong>Navigation not updating UI:</strong> Call StateHasChanged() after programmatic
                        navigation if component state depends on URL</li>
                    <li><strong>Route parameters null:</strong> Ensure [Parameter] attribute is on the property and
                        property name matches route template (case-insensitive)</li>
                </ul>
            </div>
        </div>

        <!-- How to do it -->
        <div class="bg-gradient-to-r from-gray-100 to-blue-100 rounded-2xl p-5 sm:p-6 mb-6">
            <h2 class="text-xl sm:text-2xl font-semibold text-gray-800 mb-4">🛠️ Quick Start Checklist</h2>
            <p class="text-sm text-gray-600 mb-4">Ready to add navigation to your app? Here's the quick version:</p>
            
            <ol class="list-decimal ml-5 space-y-3 text-gray-700 text-sm sm:text-base">
                <li>
                    <strong>Add @@page directive</strong> at the very top of each page component:
                    <code class="block mt-1 px-2 py-1 rounded bg-white/70 text-xs">@@page "/drivers"</code>
                </li>
                <li>
                    <strong>Create page files</strong> in <code class="px-1 rounded bg-white/70">Components/Pages/</code>:
                    <span class="text-sm text-gray-600">Drivers.razor, Trucks.razor, Routes.razor</span>
                </li>
                <li>
                    <strong>Build nav menu</strong> in <code class="px-1 rounded bg-white/70">Components/Layout/MainLayout.razor</code> using NavLink
                </li>
                <li>
                    <strong>Use NavLink</strong> with <code class="px-1 rounded bg-white/70">ActiveClass</code> for automatic highlighting:
                    <code class="block mt-1 px-2 py-1 rounded bg-white/70 text-xs">&lt;NavLink href="/drivers" ActiveClass="bg-blue-800"&gt;</code>
                </li>
                <li>
                    <strong>Add Match.All</strong> to home link to prevent it always being active:
                    <code class="block mt-1 px-2 py-1 rounded bg-white/70 text-xs">&lt;NavLink href="/" Match="NavLinkMatch.All"&gt;</code>
                </li>
                <li>
                    <strong>For code navigation</strong>, inject and use NavigationManager:
                    <code class="block mt-1 px-2 py-1 rounded bg-white/70 text-xs">Navigation.NavigateTo("/drivers");</code>
                </li>
            </ol>

            <div class="mt-4 pt-3 border-t border-blue-200">
                <p class="text-xs text-gray-600">
                    📌 <strong>Files to edit:</strong> <code class="px-1 rounded bg-white/70">MainLayout.razor</code> (nav bar) + each page component (@@page directive)
                </p>
            </div>
        </div>

        <!-- Interactive Demo -->
        <div class="bg-black/3 rounded-2xl p-6 mb-6">
            <h2 class="text-2xl font-semibold text-gray-800 mb-4">🎬 Interactive Demo: NavLink & Active States</h2>
            <p class="text-sm text-gray-600 mb-4">
                This demo shows how NavLink automatically highlights the "active" link. Click the tabs below — notice
                how the styling updates instantly!
            </p>

            <div class="bg-white rounded-2xl border border-gray-200 p-6">
                <!-- Simulated Nav Bar -->
                <div class="mb-6">
                    <p class="text-xs text-gray-500 mb-2">👇 Simulated Navigation Bar (click to see active states)</p>
                    <nav class="bg-blue-600 text-white rounded-lg p-2 flex flex-wrap gap-2">
                        <button @onclick='() => SetActiveTab("home")' class="@GetNavClass("home")">
                            🏠 Home
                        </button>
                        <button @onclick='() => SetActiveTab("drivers")' class="@GetNavClass("drivers")">
                            👥 Drivers
                        </button>
                        <button @onclick='() => SetActiveTab("trucks")' class="@GetNavClass("trucks")">
                            🚛 Trucks
                        </button>
                        <button @onclick='() => SetActiveTab("routes")' class="@GetNavClass("routes")">
                            🗺️ Routes
                        </button>
                    </nav>
                </div>

                <!-- Simulated Page Content -->
                <div class="bg-gray-50 rounded-lg p-6 mb-6 min-h-[150px]">
                    @if (activeTab == "home")
                    {
                        <h3 class="text-xl font-bold text-gray-800 mb-2">🏠 Dashboard</h3>
                        <p class="text-gray-600">Welcome to the Trucking Schedule app! This is what your home page could
                            look like.</p>
                    }
                    else if (activeTab == "drivers")
                    {
                        <h3 class="text-xl font-bold text-gray-800 mb-2">👥 Drivers</h3>
                        <p class="text-gray-600">Manage your truck drivers here. Each page has its own @@page route!</p>
                    }
                    else if (activeTab == "trucks")
                    {
                        <h3 class="text-xl font-bold text-gray-800 mb-2">🚛 Trucks</h3>
                        <p class="text-gray-600">View and manage your fleet of trucks. Navigation is instant with Blazor!
                        </p>
                    }
                    else if (activeTab == "routes")
                    {
                        <h3 class="text-xl font-bold text-gray-800 mb-2">🗺️ Routes</h3>
                        <p class="text-gray-600">Plan and track delivery routes. Notice how the nav bar highlights the
                            current page.</p>
                    }
                </div>

                <!-- What This Demonstrates -->
                <div class="bg-blue-50 rounded-lg p-4">
                    <p class="text-sm font-semibold text-blue-800 mb-2">💡 What this demonstrates:</p>
                    <ul class="list-disc ml-5 text-xs text-blue-700 space-y-1">
                        <li>The <strong>"@activeTab"</strong> tab is highlighted with a darker background (ActiveClass)
                        </li>
                        <li>In real Blazor, NavLink does this automatically based on the URL</li>
                        <li>Content swaps without a full page reload — that's the SPA magic!</li>
                    </ul>
                </div>

                <!-- Current URL Display -->
                <div class="mt-6 pt-4 border-t border-gray-200">
                    <p class="text-xs text-gray-500 mb-2">Simulated URL (what the address bar would show):</p>
                    <div class="bg-gray-100 rounded-lg p-3">
                        <code
                            class="text-sm text-gray-700">https://myapp.com<span class="text-blue-600 font-semibold">/@GetSimulatedRoute()</span></code>
                    </div>
                </div>
            </div>

            <p class="text-xs text-gray-600 mt-4 text-center">
                💡 This is a simulation — in your real app, clicking NavLinks will change the actual URL!
            </p>
        </div>

        <!-- Mark Complete -->
        <div class="bg-white rounded-xl p-6 border border-gray-200">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div>
                    <h3 class="text-xl font-semibold text-gray-800 mb-2">Ready to move on?</h3>
                    <p class="text-gray-600">
                        @if (isComplete)
                        {
                            <span class="text-green-600 font-medium">✅ Step completed!</span>
                        }
                        else
                        {
                            <span>Mark this step as complete when you're ready.</span>
                        }
                    </p>
                </div>
                <div class="flex gap-3">
                    @if (!isComplete)
                    {
                        <button @onclick="MarkComplete"
                            class="px-6 py-3 bg-green-600 hover:bg-green-700 text-white rounded-lg font-medium transition-colors">
                            ✓ Mark Complete
                        </button>
                    }
                    else
                    {
                        <button @onclick="ResetStep"
                            class="px-6 py-3 border-2 border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                            Reset Step
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <div class="mt-8">
            <div class="bg-black/90 rounded-2xl p-6 sm:p-8 text-white text-center">
                <p class="text-lg sm:text-xl font-semibold mb-4">Nice work on navigation! 🚀</p>
                <p class="text-sm text-gray-300 mb-6 max-w-2xl mx-auto">
                    Your app now has proper routing and navigation! Next up: connecting to a database with Entity
                    Framework so you can save real data.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                    <a href="/trucking-guide"
                        class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 hover:bg-white/20 rounded-xl transition-colors">
                        <span class="text-lg">←</span>
                        <span class="text-sm sm:text-base font-semibold">Back to Guide</span>
                    </a>
                    <a href="/trucking-examples/step5"
                        class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 hover:bg-white/20 rounded-xl transition-colors">
                        <span class="text-lg">←</span>
                        <span class="text-sm sm:text-base font-semibold">Previous: Step 5</span>
                    </a>
                    <a href="/trucking-examples/step7"
                        class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 rounded-xl transition-colors">
                        <span class="text-sm sm:text-base font-semibold">Next: Step 7</span>
                        <span class="text-lg">→</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
